escape ^]^]

# Ensure shells start as login shells (log ~/.bash_profile, etc.)
shell -$SHELL

startup_message off

vbell off
vbell_msg "BEEP"

nethack off
defscrollback 10000

hardstatus alwayslastline "%{= bW}%-w%{= rW}%n %t%{-}%+w %=%{= gW} %H %{= yW} %m/%d %C%a "

#screen -t Emacs	0 emacs -nw
screen -t Emacs		0 make -C ~/src/alberta-buck nix-emacs
screen -t Shell		1 bash -il



# Now using installed Ollama instead of Nix-supplied to get latest updates
#screen -t Ollama	2 bash -ilc 'sleep 0; make -C ~/src/perry-kundert-ca bucky-ollama-serve'
#screen -t BUCKy	3 bash -ilc 'sleep 2; make -C ~/src/perry-kundert-ca bucky-ollama'
# Now using MLX and Nix-supplied Python venv and HuggingFace mlx-community Qwen3.6-35B-A3B
screen -t BUCKy		10 bash -ilc 'make -C ~/src/perry-kundert-ca nix-bucky-mlx'

# The BUCK live simulation server (pyrevm worlds, one per client session):
# ws :8797 /s/<sid>/{frames,control,rpc} + http :8798 /s/<sid>/rpc (viem).
# Tunnelled as bucksim.kundert.ca (path ^/http/ -> 8798, else -> 8797).
screen -t BuckSim	11 bash -ilc 'make -C ~/src/alberta-buck nix-venv-sim-server'

# The Vantage Pulse
screen -t Pulse		12 bash -ilc 'make -C ~/src/Vantage/Pulse-prod nix-start PULSE_ENV=production'

# Start up the Lightning Watch ingest/serve
screen -t L.Ingest	13 bash -ilc 'sleep 1; make -C ~/src/Vantage/1885-Create-DevOps/lightning_watch nix-venv-ingest'
screen -t L.Serve	14 bash -ilc 'sleep 9; make -C ~/src/Vantage/1885-Create-DevOps/lightning_watch nix-venv-serve'

